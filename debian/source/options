# Keep the source package to the build scripts. The VS Code checkout, the
# packaged application tree and the built assets are produced by the build and
# must not end up in the tarball.
tar-ignore = .git
tar-ignore = .github
tar-ignore = vscode
tar-ignore = VSCode-*
tar-ignore = assets
tar-ignore = .zcodeignore
# debhelper / dpkg-buildpackage artifacts from an earlier host build
tar-ignore = debian/codium
tar-ignore = debian/.debhelper
tar-ignore = debian/files
tar-ignore = debian/*.substvars
tar-ignore = debian/*.debhelper.log
tar-ignore = debian/debhelper-build-stamp
# debian/vendor is deliberately NOT ignored, even though it is several GB. The
# build has to run with no external network at all - the internal build platform
# cannot reach github.com, the npm registry, nuget.org or nodejs.org, and this
# source package is all it has - so the vendored dependencies have to travel in
# it. pbuilder also unpacks the source as its build user, which means the caches
# the build writes into come out writable and need no staging.
