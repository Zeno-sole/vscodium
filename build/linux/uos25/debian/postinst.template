#!/usr/bin/env bash
#
# UOS 25 post-install script for VSCodium.
#
# Derived from the upstream resources/linux/debian/postinst.template with the
# Microsoft apt-repository registration removed. Upstream writes
# /etc/apt/sources.list.d/vscode.sources pointing at
# https://packages.microsoft.com/repos/code and installs Microsoft's signing
# key, guarded by `if [ "@@NAME@@" != "code-oss" ]` - which is true for every
# VSCodium build, since prepare_vscode.sh renames the application to `codium`.
#
# On UOS that endpoint is unreachable, so the package would leave the machine
# with a source list that makes every later `apt update` fail. The matching
# debconf question and the postrm cleanup are dropped as well, so the package
# ships no debconf templates at all.

# Symlink bin command to /usr/bin
rm -f /usr/bin/@@NAME@@
ln -s /usr/share/@@NAME@@/bin/@@NAME@@ /usr/bin/@@NAME@@

# Register code in the alternatives system
# Priority of 0 should never make code the default editor in auto mode as most
# developers would prefer a terminal editor as the default.
update-alternatives --install /usr/bin/editor editor /usr/bin/@@NAME@@ 0

# Install the desktop entry
if hash update-desktop-database 2>/dev/null; then
	update-desktop-database
fi

# Update mimetype database to pickup workspace mimetype
if hash update-mime-database 2>/dev/null; then
	update-mime-database /usr/share/mime
fi

# Remove the legacy bin command left behind by older packages
if [ "@@NAME@@" = "code" ]; then
	rm -f /usr/local/bin/code
fi

exit 0
