# arm64 (aarch64) vendor manifest
#
# Same layout as amd64.list. What differs from amd64:
#
#   * the Electron runtime is the arm64 build;
#   * the Foundry Local runtime uses the cross-platform
#     Microsoft.ML.OnnxRuntime.Foundry package, because
#     Microsoft.ML.OnnxRuntime.Gpu.Linux only ships x86_64 binaries
#     (see foundry-local-sdk/script/install-standard.cjs);
#   * node-gyp's Electron and Node headers are architecture independent, so the
#     same tarballs are used.
#
# arm64 builds of VSCodium run on an arm64 host (upstream CI uses native arm64
# runners), so this vendor directory - and especially the npm cache, which holds
# the arm64 native prebuilds - has to be populated on one.

# Electron runtime
69c2d141d2123e640d765e49a54a4478856adad67cee048bb2bb4f244f388f87  electron/v43.7.3/electron-v43.7.3-linux-arm64.zip  https://github.com/electron/electron/releases/download/v43.7.3/electron-v43.7.3-linux-arm64.zip
f6f043c23f000eb57b4a6aece3a1c20799856f1b39bb7daa6c0f01cc574439ae  electron/v43.7.3/SHASUMS256.txt  https://npmmirror.com/mirrors/electron/43.7.3/SHASUMS256.txt
# build/npm/electronTypes.ts wants this and skips the download when the file is
# already present with the checksum from build/checksums/electron.txt
8548646380ade5e0f5177707a89b4a2e491e62381686155e73314d2999ca7f46  electron/v43.7.3/electron.d.ts  https://github.com/electron/electron/releases/download/v43.7.3/electron.d.ts

# node-gyp headers: the Electron ABI (client) and Node (remote/server)
