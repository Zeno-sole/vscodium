#!/bin/sh
# pbuilder A hook: repair UOS 25's truncated node-undici before the build runs.
#
# A hooks run after the build dependencies are installed and after the source is
# unpacked, but before dpkg-buildpackage - the only point at which the broken file
# exists and the build can still be fixed. The build itself cannot do it: pbuilder
# runs it as an unprivileged user and the file belongs to the system nodejs.
#
# Without this, every fetch() in the archive's nodejs fails with a WebAssembly
# CompileError, and the build dies minutes later somewhere unrelated. What is
# wrong, and why, is documented in build/linux/uos25/fix-undici-wasm.mjs.
#
# The repair itself lives in the unpacked source, which is what $BUILDDIR points
# at; the hook only has to find it.

set -e

REPAIR=""
for candidate in \
	"${BUILDDIR}/build/linux/uos25/fix-undici-wasm.mjs" \
	"${BUILDDIR}"/*/build/linux/uos25/fix-undici-wasm.mjs; do
	if [ -f "${candidate}" ]; then
		REPAIR="${candidate}"
		break
	fi
done

if [ -z "${REPAIR}" ]; then
	echo "A10undici: fix-undici-wasm.mjs not found under ${BUILDDIR} - skipping" >&2
	exit 0
fi

echo "A10undici: repairing UOS 25's node-undici (see build/linux/uos25/fix-undici-wasm.mjs)"
node "${REPAIR}"
