+// Load all the gulpfiles only if running tasks other than the editor tasks.
+// Dynamic import rather than require(): the gulpfiles are ES modules, and
+// require() of an ES module only works from Node 22.12 onwards. This build has
+// to run on the Node 20 that UOS 25 ships.
+for (const f of glob.sync('gulpfile.*.ts', { cwd: import.meta.dirname })) {
+	await import(`./${f}`);
+}
